# ============================================================
# Wasel .gitignore — consolidated from ~200 ad hoc entries.
# Organized by category. Same coverage as before, deduped.
# NOTE: a few original one-off entries referenced files that
# didn't exist at root at time of cleanup — kept anyway since
# removing a pattern is riskier than an unused line.
# FIXED 2026-09-13: "Dockerfile.*" below previously matched the tracked
# Dockerfile.dev on a fresh clone. Added an explicit negation for it.
# ============================================================

# ---- Build output ----
build/
dist/
.vite/
.next/
*.tsbuildinfo

# ---- Dependencies ----
node_modules/
with-supabase-app/node_modules/
yarn.lock
.yarn/

# ---- Environment variables ----
# .env.example is the only env file that should be committed.
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env*.local
# catch-all for any env variant not listed above (templates stay committed)
.env?*
!.env.example
!.env.production.template
!.env.production.staging.template
!.env.edge.template
.env.original
.env.testcopy
.env-LaithNassar.*
.env.production-LaithNassar.*

# ---- Git internals ----
.git-rewrite/
# Nested git repo (wasel/ has its own .git)
wasel/

# ---- Supabase local state ----
supabase/.branches/
supabase/.temp/

# ---- Test and coverage output ----
coverage/
test-results/
playwright-report/
tests/e2e/screenshots/
tests/e2e/visual-report/
.playwright-mcp/
.playwright/

# ---- Logs ----
*.log
