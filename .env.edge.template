# ==============================================================================
# WASEL - SERVER-SIDE SECRETS TEMPLATE (placeholders only, safe to commit)
# ==============================================================================
# Copy this file OUTSIDE the project (OneDrive-synced folder), for example to
#   %USERPROFILE%\.wasel-secrets\edge-secrets.env
# fill in the real values there, then load it with:
#   supabase secrets set --env-file "$env:WASEL_ENV_DIR\edge-secrets.env" --project-ref <project-ref>
# Delete the filled-in copy when you are done. Never put real values in this file.
#
# NOTE: the Supabase CLI skips any name starting with SUPABASE_ (reserved, injected for you).
# The Send SMS hook secret is therefore read from SEND_SMS_HOOK_SECRET.
#
# Not here on purpose: Vercel tokens, Stripe recovery codes, Google service-account
# JSON files. Keep those in a password manager / secret store, not in env files.
# ==============================================================================

# ---- Database (reset the password in Supabase first, then paste the new one) ----
DATABASE_URL=postgresql://postgres:[YOUR-NEW-DB-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# ---- Supabase auth hook ----
# Generated by Supabase when you enable the Send SMS hook (Authentication > Hooks).
# Named SEND_SMS_HOOK_SECRET because Supabase rejects secret names starting with SUPABASE_.
SEND_SMS_HOOK_SECRET=PASTE_HOOK_SECRET_FROM_SUPABASE_HERE

# ---- Stripe ----
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE

# ---- Twilio ----
TWILIO_AUTH_TOKEN=PASTE_YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_ACCOUNT_SID=PASTE_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_API_KEY_SID=PASTE_YOUR_TWILIO_API_KEY_SID_HERE
TWILIO_API_KEY_SECRET=PASTE_YOUR_TWILIO_API_KEY_SECRET_HERE
# Identifier, not a secret (Twilio Console > Messaging > Services).
TWILIO_MESSAGING_SERVICE_SID=MG4e839d3e92c8d7ccbdd0b2cb5ae6df7e
TWILIO_VERIFY_SERVICE_SID=PASTE_YOUR_TWILIO_VERIFY_SERVICE_SID_HERE

# ---- Email ----
RESEND_API_KEY=PASTE_YOUR_RESEND_API_KEY_HERE
SENDGRID_API_KEY=PASTE_YOUR_SENDGRID_API_KEY_HERE

# ---- Worker / webhook tokens (generate two different values) ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMUNICATION_WORKER_SECRET=PASTE_GENERATED_RANDOM_VALUE_HERE
COMMUNICATION_WEBHOOK_TOKEN=PASTE_DIFFERENT_GENERATED_RANDOM_VALUE_HERE

# ---- Other payment / trust webhooks ----
CLIQ_WEBHOOK_SECRET=PASTE_YOUR_CLIQ_WEBHOOK_SECRET_HERE
SANAD_WEBHOOK_SECRET=PASTE_YOUR_SANAD_WEBHOOK_SECRET_HERE

# ---- CLIQ API credentials (read by make-server-0b1f4071) ----
CLIQ_API_KEY=PASTE_YOUR_CLIQ_API_KEY_HERE
CLIQ_MERCHANT_ID=PASTE_YOUR_CLIQ_MERCHANT_ID_HERE
CLIQ_CHECKOUT_URL_TEMPLATE=https://payments.cliq.jo/checkout?tx={transactionId}&amount={amount}&currency={currency}&return_url={returnUrl}

# ---- JOPACC API credentials (read by make-server-0b1f4071) ----
JOPACC_API_KEY=PASTE_YOUR_JOPACC_API_KEY_HERE
JOPACC_MERCHANT_ID=PASTE_YOUR_JOPACC_MERCHANT_ID_HERE
JOPACC_CHECKOUT_URL_TEMPLATE=PASTE_YOUR_JOPACC_CHECKOUT_URL_TEMPLATE_HERE

# ---- Stripe subscription price (read by make-server-0b1f4071) ----
STRIPE_WASEL_PLUS_PRICE_ID=price_PASTE_YOUR_PRICE_ID_HERE

# ---- Event broker (browser calls the proxy with this shared token) ----
# Not a high-entropy secret; it gates anonymous event-broker-proxy writes.
EVENT_BROKER_WORKER_SECRET=PASTE_GENERATED_RANDOM_VALUE_HERE

# ---- Scheduled / internal jobs ----
INTERNAL_CRON_SECRET=PASTE_GENERATED_RANDOM_VALUE_HERE

# ---- Origins ----
# Comma-separated browser origins allowed to call the functions.
# MUST stay false in production.
ALLOWED_ORIGINS=https://www.wasel14.online,https://wasel14.online
ALLOW_LOCAL_ORIGINS=false
# Preview deployments, only if you rely on Vercel preview URLs.
ALLOW_PREVIEW_ORIGINS=false
# Canonical public origin used to build redirect/return URLs server-side.
APP_BASE_URL=https://www.wasel14.online
APP_ORIGIN=https://www.wasel14.online
PUBLIC_SITE_URL=https://www.wasel14.online

# ---- Redis (optional; skip if unused) ----
REDIS_URL=redis://your-redis-host:6379
REDIS_TOKEN=PASTE_YOUR_REDIS_TOKEN_HERE

# ---- Injected by the Supabase platform, do NOT set here ----
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and VERCEL_URL are
# supplied automatically. Setting them in this file is a no-op at best and can
# shadow a rotation at worst.
