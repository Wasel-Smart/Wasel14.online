{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true,
    "noImplicitAny": true
  
  },
  "lint": {
    "include": ["./"],
    "exclude": ["tests/", "globals.d.ts", "_vendor/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["no-explicit-any", "no-unused-vars", "eqeqeq"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true
  }
}
 