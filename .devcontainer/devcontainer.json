// Wasel dev container: Node 22 + TypeScript. The earlier .NET / MS SQL template
// was unrelated to this stack (React + Vite + Supabase) and has been replaced.
// See https://aka.ms/devcontainer.json for the format.
{
	"name": "Wasel (Node 22, TypeScript)",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
	"features": {
		// Needed for `docker-compose -f docker-compose.dev.yml up` and `supabase start`.
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"forwardPorts": [5173, 4173, 54321, 54323],
	"portsAttributes": {
		"5173": { "label": "Vite dev server" },
		"4173": { "label": "Vite preview" },
		"54321": { "label": "Supabase API" },
		"54323": { "label": "Supabase Studio" }
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"denoland.vscode-deno",
				"ms-playwright.playwright"
			],
			"settings": {
				// Deno only applies to the edge functions; the rest of the repo is Node.
				"deno.enablePaths": ["supabase/functions"]
			}
		}
	},
	// Secrets never live in the container image. Keep real env files outside the
	// project and point WASEL_ENV_DIR at them (see .env.example).
	"postCreateCommand": "npm ci --legacy-peer-deps"
}
