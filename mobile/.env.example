# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API Configuration
# EXPO_PUBLIC_API_URL is the functions base; EXPO_PUBLIC_SUPABASE_FUNCTION_URL is the
# single deployed function. Both are read (src/lib/config.ts, src/screens/BusScreen.tsx).
EXPO_PUBLIC_API_URL=https://your-project.supabase.co/functions/v1
EXPO_PUBLIC_SUPABASE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/make-server-0b1f4071

# Realtime driver socket (src/services/location.ts)
EXPO_PUBLIC_WS_URL=wss://your-app.example/ws

# Deep-link callback (src/lib/config.ts, default wasel://auth/callback)
EXPO_PUBLIC_AUTH_REDIRECT_URL=wasel://auth/callback

# Google Maps
# NOTE the name: config.ts reads EXPO_PUBLIC_GOOGLE_MAPS_KEY (no _API_ suffix).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# Stripe (optional; gates the payments UI via waselMobileConfig.hasStripe)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.jo.your-app

# Monitoring
EXPO_PUBLIC_SENTRY_DSN=

# App identity / build metadata (src/App.tsx, src/services/performance.tsx)
EXPO_PUBLIC_APP_SCHEME=wasel
EXPO_PUBLIC_APP_DOMAIN=your-app.example
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_BUILD_NUMBER=
EXPO_PUBLIC_ENVIRONMENT=development

# Support Contact
# NOTE: EXPO_PUBLIC_SUPPORT_* are not read by mobile code yet. The support links in
# the app are driven by the web build. Kept for parity with the web env files.
EXPO_PUBLIC_SUPPORT_WHATSAPP=962790000000
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_SUPPORT_PHONE=962790000000

# Feature Flags
# WARNING: none of the three below are read by mobile code yet. They are kept so
# the intent stays recorded, but setting them changes nothing at runtime. Wire them
# up in src/lib/config.ts before relying on them.
EXPO_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
