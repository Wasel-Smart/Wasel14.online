# Enforce LF line endings for all text files checked into the repo.
# This prevents CRLF/LF churn on Windows (OneDrive) <-> Linux (CI) round-trips.
* text=auto eol=lf

# Explicitly text
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.env*      text eol=lf
*.conf      text eol=lf
*.config    text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf

# Shell scripts must be LF or they fail on Linux CI
*.sh        text eol=lf

# Binary — never diff or merge
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.mp4       binary
*.mov       binary
*.pem       binary
*.key       binary
*.p12       binary
*.crt       binary
